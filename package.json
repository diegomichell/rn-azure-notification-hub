{
  "name": "rn-azure-notification-hub",
  "version": "0.1.1",
  "description": "React Native / Expo wrapper for the Azure Notification Hubs native iOS and Android SDKs",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/ plugin/src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "azure",
    "azure-notification-hubs",
    "notification-hubs",
    "push-notifications",
    "push",
    "notifications",
    "apns",
    "fcm",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegomichell/rn-azure-notification-hub.git"
  },
  "bugs": {
    "url": "https://github.com/diegomichell/rn-azure-notification-hub/issues"
  },
  "author": "Diego Michel <diego.ivan.perez.michel@gmail.com> (https://github.com/diegomichell)",
  "license": "MIT",
  "homepage": "https://github.com/diegomichell/rn-azure-notification-hub#readme",
  "files": [
    "android/build.gradle",
    "android/src",
    "ios",
    "src",
    "!src/__tests__",
    "build",
    "plugin/build",
    "!plugin/build/tsconfig.tsbuildinfo",
    "docs",
    "app.plugin.js",
    "expo-module.config.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@expo/config-plugins": "~57.0.8",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.7",
    "eslint": "~10.9.1",
    "eslint-config-universe": "^16.0.0",
    "expo": "^57.0.13",
    "expo-modules-core": "~57.0.11",
    "jest": "^30.5.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.0.0",
    "react-native": "^0.86.2",
    "typescript": "^7.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": ">=54.0.0",
    "react": "*",
    "react-native": "*"
  }
}
